{
  "name": "difflow-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Front end for difflow.gui. Built to ../static/, which is committed, so installing difflow never needs node.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.publish.config.js",
    "preview": "vite preview",
    "test": "node --test src/lib/model/*.test.js",
    "build:editor": "vite build",
    "build:publish": "vite build -c vite.publish.config.js"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "svelte": "^5.39.5",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@xyflow/svelte": "^1.3.1",
    "katex": "^0.16.47"
  }
}
